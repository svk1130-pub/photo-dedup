# Photo Dedup: хост-корень с фотографиями.
# Скопируйте в .env рядом с docker-compose.yml и при необходимости поправьте:
#   cp .env.example .env
#
# Папка, ВНУТРИ которой лежат src/ (архив) и trash/ (дубликаты).
# Именно она монтируется в контейнеры как /photos; пути в settings.toml
# указываются как на хосте, например /home/me/myfotos/src.
# По умолчанию — подпапка photos рядом с docker-compose.yml:
#   mkdir -p photos/src photos/trash
PHOTOS_ROOT=./photos
